{
  "img_size": [224, 224],
  "batch_size": 32,
  "seed": 42,
  "epochs": 30,
  "learning_rate": 0.001,
  "reduce_lr_factor": 0.5,
  "reduce_lr_patience": 3,
  "early_stopping_patience": 10,
  "dropout": {
    "bloc1": 0.1,
    "bloc2": 0.1,
    "bloc3": 0.15,
    "bloc4": 0.15,
    "head": 0.5
  },
  "filters": [16, 32, 64],
  "dense_units": 64,
  "l2": 0.0001,
  "shuffle_buffer": 500,
  "augmentation": {
    "flip": "horizontal",
    "rotation": 0.08,
    "zoom": 0.1,
    "translation": 0.1
  },
  "class_names": ["Painting", "Photo", "Schematics", "Sketch", "Text"]
}
