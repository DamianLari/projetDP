{
  "img_size": [224, 224],
  "batch_size": 32,
  "seed": 42,
  "backbone": "EfficientNetB0",
  "epochs_head": 10,
  "lr_head": 0.0005,
  "epochs_finetune": 40,
  "lr_finetune": 2e-05,
  "unfreeze_fraction": 0.1,
  "reduce_lr_factor": 0.5,
  "reduce_lr_patience": 3,
  "early_stopping_patience": 5,
  "dense_units": 256,
  "dropout_head": 0.5,
  "shuffle_buffer": 1000,
  "augmentation": {
    "brightness": 0.1,
    "contrast": 0.05,
    "saturation": 0.1,
    "zoom": 0.15
  },
  "class_names": ["Painting", "Photo"]
}
